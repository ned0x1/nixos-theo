{
    "custom/updates": {
        "format": " ",
        "escape": false,
        "return-type": "json",
        "on-click": "~/.config/waybar/scripts/toggle_eww_updates.sh",
        "on-click-right": "kitty --title 'Installed Packages' sh -c ~/.config/waybar/scripts/listpackages.sh",
        "tooltip": true
    }
}