(defwindow updates
  :stacking "fg"
  :anchor "top center"
  :geometry (geometry :x "50%"
                      :y "30px"
                      :width "180px"
                      :height "80px")
  :background "#1f2430"
  :focusable "ondemand"
  (box :orientation "vertical" :spacing 6 :class "updates-box"
    (button :class "update-btn" :label "Système" :onclick "sh -c '/home/theo/.config/waybar/scripts/run_system_update.sh' &")
    (button :class "update-btn" :label "Home" :onclick "sh -c '/home/theo/.config/waybar/scripts/run_home_update.sh' &")))
