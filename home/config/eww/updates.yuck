(defwindow updates
  :stacking "fg"
  :anchor "top right"
  :monitor 0
  :geometry (geometry :x "88%"
                      :y "0%"
                      :width "12%"
                      :height "15%")
  :background "#1f2430"
  (box :orientation "vertical" :spacing 4 :class "updates-box"
    (button :class "update-btn" :onclick "sh -c '/home/theo/.config/waybar/scripts/run_system_update.sh && eww close updates' &" "Système")
    (button :class "update-btn" :onclick "sh -c '/home/theo/.config/waybar/scripts/run_home_update.sh && eww close updates' &" "Home")))

(defwindow updates-overlay
  :stacking "bg"
  :anchor "top left"
  :monitor 0
  :geometry (geometry :x "0%"
                      :y "0%"
                      :width "100%"
                      :height "100%")
  (eventbox :onclick "eww close updates updates-overlay"
    (box :class "overlay-bg")))
