(defwindow updates
  :layer "overlay"
  :anchor "top-left"
  :x 0
  :y 0
  :width 180
  :height 80
  :background "#1f2430"
  :children (
    (box :orientation vertical :spacing 6 :margin 8
      (button :label "Système" :onclick "~/.config/waybar/scripts/run_system_update.sh")
      (button :label "Home" :onclick "~/.config/waybar/scripts/run_home_update.sh"))))
